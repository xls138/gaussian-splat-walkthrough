{
  "name": "gaussian-splat-walkthrough",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "splat:help": "splat-transform --help",
    "splat:convert:sog": "splat-transform -w",
    "splat:convert": "powershell -ExecutionPolicy Bypass -File scripts/convert-splats.ps1",
    "validate:layout": "node scripts/validate-layout.mjs",
    "unreal:export-layout": "powershell -ExecutionPolicy Bypass -File scripts/export-unreal-layout.ps1"
  },
  "dependencies": {
    "playcanvas": "^2.21.3",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@playcanvas/splat-transform": "^3.2.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  }
}
